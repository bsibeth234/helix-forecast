# Helix does not need a local .env in the preview.
# Deploy injects these — do not commit secrets.
#
# DATABASE_URL=postgres://...     # Neon in production; omitted → PGLite
# BETTER_AUTH_SECRET=             # injected per-app session secret
#
# Google and X sign-in federate through the Grok auth broker.
# Demo email/password accounts are seeded (see README).
